{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/scripts/agent-usage-logger.sh codex"
          }
        ]
      },
      {
        "matcher": "spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/scripts/agent-usage-logger.sh codex"
          }
        ]
      }
    ]
  }
}
